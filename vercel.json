{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "supabase/schema.sql"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/actions.json",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|src/assets/|actions\\.json|manifest\\.webmanifest|sw\\.js|registerSW\\.js|workbox-.*|favicon\\.ico|favicon-32x32\\.png|apple-touch-icon\\.png|icon\\.svg|pwa-.*\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
