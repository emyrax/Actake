{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "supabase/schema.sql"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/actions.json",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|actions\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
