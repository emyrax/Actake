# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_POLLAR_API_KEY: Publishable Pollar API key from https://dashboard.pollar.xyz.
# Enables Pollar Sign-In (Email OTP, Google, GitHub, Passkey Smart Wallet & Solana Wallet Standard),
# Fiat-to-Crypto Wallet Funding (Pollar Ramp & Receive QR), and Solana SPL Stake Payments.
VITE_POLLAR_API_KEY=""

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Server-side Supabase PostgreSQL credentials.
# Run supabase/schema.sql in your Supabase SQL Editor to create the pools, participants, and checkins tables.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# SOLANA_RPC_URL: Optional dedicated Solana RPC endpoint (defaults to https://api.devnet.solana.com).
SOLANA_RPC_URL=""

# ORACLE_PRIVATE_KEY_HEX: Optional 64-char hex Ed25519 seed for deterministic on-chain oracle attestations.
ORACLE_PRIVATE_KEY_HEX=""

# VITE_ACTAKE_ESCROW_PROGRAM_ID: Optional deployed Solana Devnet Anchor Program ID
# (from programs/actake_escrow). When omitted, Actake broadcasts live Devnet Ed25519+Memo receipts.
VITE_ACTAKE_ESCROW_PROGRAM_ID=""



