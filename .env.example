# =============================================================================
# Actake Environment Variables (Vercel Project Settings & Local Dev)
# Never commit real secret values to git. Add these in Vercel -> Project Settings
# -> Environment Variables (or AI Studio Secrets panel).
# =============================================================================

# GEMINI_API_KEY (Required, server-only):
# Gemini AI API key for randomized challenge generation & live camera verification.
GEMINI_API_KEY=""

# APP_URL (Recommended, server-only):
# Your production web app URL used for Solana Blinks (/actions.json) & share links.
# For your Vercel deployment, set this to: https://actake.vercel.app
APP_URL="https://actake.vercel.app"

# VITE_POLLAR_API_KEY (Required for Pollar, client publishable key):
# Publishable Pollar API key from https://dashboard.pollar.xyz.
# IMPORTANT: Add https://actake.vercel.app under Allowed Origins in Pollar Dashboard.
VITE_POLLAR_API_KEY=""

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY (Recommended, server-only):
# Server-side Supabase PostgreSQL credentials.
# Run supabase/schema.sql in your Supabase SQL Editor to create pools, participants, and checkins tables.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# SOLANA_RPC_URL (Optional, server-only):
# Dedicated Solana RPC endpoint (defaults to https://api.devnet.solana.com).
SOLANA_RPC_URL=""

# ORACLE_PRIVATE_KEY_HEX (Optional, server-only):
# 64-char hex Ed25519 seed for deterministic on-chain oracle attestations across serverless invocations.
ORACLE_PRIVATE_KEY_HEX=""

# VITE_ACTAKE_ESCROW_PROGRAM_ID (Optional, client public config):
# Deployed Solana Devnet Anchor Program ID (from programs/actake_escrow).
# When omitted, Actake broadcasts live Devnet Ed25519+Memo receipts.
VITE_ACTAKE_ESCROW_PROGRAM_ID=""
